# Local development settings. Copy to .env (git-ignored) and generate secrets:
#   cp .env.example .env && ./scripts/gen-secrets.sh >> .env
# On Railway, set these as service variables instead (docs/DEPLOY_RAILWAY.md).

TZ=Etc/UTC
BOOKSTACK_PORT=6875
MAILPIT_UI_PORT=8025

# Must match the URL users open, including scheme and port. No trailing slash.
APP_URL=http://localhost:6875

# Plain-HTTP localhost cannot rely on Secure cookies in every browser.
# ALWAYS true on Railway.
SESSION_SECURE_COOKIE=false

# Trusted reverse proxies. Empty locally. On Railway: * (the container is
# only reachable through Railway's edge proxy).
APP_PROXIES=

# Comma/space-separated hosts allowed in page iframes. Empty = none.
ALLOWED_IFRAME_SOURCES=

API_REQUESTS_PER_MIN=120

DB_DATABASE=bookstack
DB_USERNAME=bookstack

# Mail: defaults point at the local mailpit container. On Railway use a real
# SMTP provider with MAIL_ENCRYPTION=tls.
MAIL_FROM=bookstack@example.local
MAIL_FROM_NAME=BookStack

# --- Secrets: appended by scripts/gen-secrets.sh, never commit real values ---
# APP_KEY=base64:...
# DB_PASSWORD=...
# DB_ROOT_PASSWORD=...
